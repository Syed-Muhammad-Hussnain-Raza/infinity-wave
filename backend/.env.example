# Application Configuration
PROJECT_NAME="NovaWorks AI Project Manager"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Default to SQLite for simple local development, override with PostgreSQL in production)
# SQLite fallback: sqlite:///./novaworks.db
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/novaworks_db
DATABASE_URL=sqlite:///./novaworks.db

# JWT & Security Configuration
# Run: openssl rand -hex 32 to generate a strong key
SECRET_KEY=novaworks_super_secret_hackathon_key_2026_dev_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://infinity-wave-bice.vercel.app,https://infinity-wave-api.onrender.com

# AI Integration - Primary Provider (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Integration - Fallback Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
